        "jamSelesai": { "type": "string", "maxLength": 10 },
        "durasiMenit": { "type": "number" },
        "ruangan": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["idKelas", "namaKelas", "idTutor", "namaTutor", "hari", "jamMulai", "jamSelesai", "durasiMenit", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
