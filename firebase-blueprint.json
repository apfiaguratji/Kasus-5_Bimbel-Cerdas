    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Pencatatan pembayaran."
    },
    "/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/Receipt" },
      "description": "Kuitansi digital."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
