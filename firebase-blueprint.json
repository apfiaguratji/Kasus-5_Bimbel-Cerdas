    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Pendaftaran siswa baru."
    },
    "/waitlists/{waitlistId}": {
      "schema": { "$ref": "#/entities/Waitlist" },
      "description": "Antrean daftar tunggu kelas penuh."
    },
    "/student_attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/StudentAttendance" },
      "description": "Absensi siswa per pertemuan."
    },
    "/tutor_attendance/{tutorAttendanceId}": {
      "schema": { "$ref": "#/entities/TutorAttendance" },
