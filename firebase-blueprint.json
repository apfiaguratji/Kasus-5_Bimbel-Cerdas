      "type": "object",
      "properties": {
        "parentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "idSiswa": { "type": "string", "maxLength": 128 },
        "namaSiswa": { "type": "string", "maxLength": 120 },
