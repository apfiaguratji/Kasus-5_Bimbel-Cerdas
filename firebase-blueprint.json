      "type": "object",
      "properties": {
        "idKelas": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "namaKelas": { "type": "string", "maxLength": 100 },
