      "title": "UserAccount",
      "description": "Akun dan hak akses pengguna untuk empat peran sistem.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nama": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["orang_tua", "tutor", "admin", "pemilik"] },
        "noTelepon": { "type": "string", "maxLength": 32 },
        "alamat": { "type": "string", "maxLength": 300 },
        "linkedTutorId": { "type": "string", "maxLength": 128 },
        "statusAktif": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "nama", "email", "role", "statusAktif", "createdAt", "updatedAt"]
    },
    "Program": {
      "title": "Program",
      "description": "Program bimbingan belajar (SD, SMP, SMA/UTBK).",
      "type": "object",
      "properties": {
        "namaProgram": { "type": "string", "minLength": 2, "maxLength": 100 },
        "jenjang": { "type": "string", "enum": ["SD", "SMP", "SMA", "UTBK"] },
        "biayaSpp": { "type": "number" },
        "biayaPendaftaran": { "type": "number" },
        "frekuensiMingguan": { "type": "number" },
        "durasiMenit": { "type": "number" },
        "deskripsi": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["namaProgram", "jenjang", "biayaSpp", "biayaPendaftaran", "frekuensiMingguan", "durasiMenit", "deskripsi", "createdAt", "updatedAt"]
    },
    "Tutor": {
      "title": "Tutor",
