    },
    "/programs/{programId}": {
      "schema": { "$ref": "#/entities/Program" },
      "description": "Katalog program bimbel publik."
    },
    "/tutors/{tutorId}": {
      "schema": { "$ref": "#/entities/Tutor" },
      "description": "Data tutor dan keahlian."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassRoom" },
