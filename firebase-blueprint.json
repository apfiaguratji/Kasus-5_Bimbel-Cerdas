      },
      "required": ["namaTutor", "email", "noTelepon", "bidangKeahlian", "statusAktif", "createdAt", "updatedAt"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Data kelas dengan kapasitas maks 8 dan min 3 siswa.",
      "type": "object",
      "properties": {
        "idProgram": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
