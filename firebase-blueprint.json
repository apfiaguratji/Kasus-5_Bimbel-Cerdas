      "required": ["parentUid", "parentName", "idSiswa", "namaSiswa", "idProgram", "namaProgram", "idKelas", "namaKelas", "biayaPendaftaran", "statusBayarDaftar", "statusPendaftaran", "tanggalDaftar", "createdAt", "updatedAt"]
    },
